# Microsoft Foundry API key
# Get it from your Foundry project: Settings → Keys and Endpoint
FOUNDRY_KEY=your-foundry-api-key-here

# Foundry project endpoint (no trailing slash, no /openai/v1 suffix)
FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>

# Deployment names in your Foundry project (optional; defaults shown)
KIMI_MODEL=FW-Kimi-K3-3
GPT_MODEL=gpt-5.6-sol

# Direct Fireworks serverless configuration
FIREWORKS_KEY=your-fireworks-api-key-here
FIREWORKS_BASE=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/kimi-k3

# Optional stateless-classifier load shape (direct Fireworks)
CLASSIFIER_WAVE_SIZE=12
CLASSIFIER_WAVES=3
CLASSIFIER_SHARDS=12

# Optional stateless-classifier load shape (Foundry; lower default to avoid 429s)
FOUNDRY_CLASSIFIER_WAVE_SIZE=3
FOUNDRY_CLASSIFIER_WAVES=2
FOUNDRY_CLASSIFIER_SHARDS=4
