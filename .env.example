# Microsoft Foundry API key — required by all three demos
# Get it from your Foundry project: Settings → Keys and Endpoint
FOUNDRY_KEY=your-foundry-api-key-here

# Foundry project endpoint (no trailing slash, no /openai/v1 suffix)
FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>

# Deployment names in your Foundry project (optional; defaults shown)
KIMI_MODEL=FW-Kimi-K3-3
GPT_MODEL=gpt-5.6-sol
